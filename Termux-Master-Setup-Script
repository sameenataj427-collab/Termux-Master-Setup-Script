clear
echo "==============================================="
echo "       🚀 TERMUX ENVIRONMENT SETUP 🚀         "
echo "==============================================="

echo "📦 Updating system packages..."
pkg update -y && pkg upgrade -y

echo "🛠️  Installing essential tools..."
pkg install android-tools termux-api wget make zip 7zip libusb clang git curl python python3 -y

echo "🔌 Setting up ADB & Fastboot..."
curl -s https://raw.githubusercontent.com/nohajc/termux-adb/master/install.sh | bash

echo "📁 Requesting storage permissions..."
termux-setup-storage

echo "🦊 Installing MiTool..."
curl -s https://raw.githubusercontent.com/offici5l/termux-adb-fastboot/main/install | bash
echo "==============================================="
echo "        ✅ SETUP COMPLETED SUCCESSFULLY!       "
echo "==============================================="
